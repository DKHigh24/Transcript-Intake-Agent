# ── LLM Authentication (choose ONE) ─────────────────────────────────────────
# Option A: OpenAI API key (if your org permits it)
OPENAI_API_KEY=sk-replace-with-your-key

# Option B: GitHub Personal Access Token with 'copilot' scope (recommended)
# Generate at: https://github.com/settings/tokens
# Required scopes: copilot (read access to GitHub Copilot Chat)
# GITHUB_TOKEN=ghp_replace-with-your-github-pat

# ── Power Automate (optional) ────────────────────────────────────────────────
POWER_AUTOMATE_URL=https://replace-with-your-flow-url
ENABLE_POWER_AUTOMATE_PUSH=false
DEFAULT_STATUS=(2) Needs Review

# ── Azure DevOps (optional — for push/sync via ado_client.py) ───────────────
# Generate a PAT at: https://dev.azure.com/{YourOrg}/_usersSettings/tokens
# Required PAT scope: Work Items → Read & Write
# PAT expiry: renew at https://dev.azure.com/{YourOrg}/_usersSettings/tokens
ADO_ORG_URL=https://dev.azure.com/YourOrg
ADO_PROJECT=YourProject
ADO_PAT=replace-with-your-ado-pat
ADO_WORK_ITEM_TYPE=Issue
ADO_DEFAULT_AREA_PATH=YourProject
ADO_PARENT_EPIC_TITLE=Electronics AI Working Group Opportunities


# ── Human Review / Feedback Loop ─────────────────────────────────────────────
# Your reviewer identity — written to all feedback log records and queue actions.
# Defaults to os.getlogin() if not set.
REVIEWER_ID=your.name

# Minimum overall classifier accuracy (0.0–1.0) required before --mode promote-feedback
# is allowed to apply staged feedback changes. Default: 0.80
FEEDBACK_PROMOTION_THRESHOLD=0.80

# Fuzzy similarity ratio (0.0–1.0) above which two candidates from the same
# session are considered near-duplicates and merged. Higher = stricter (fewer merges).
DEDUP_SIMILARITY_THRESHOLD=0.72

# Maximum number of candidates allowed per session after deduplication.
# Excess candidates (lowest confidence first) are routed to the Triage sheet
# in review_rows.xlsx rather than the primary Opportunities sheet.
MAX_CANDIDATES_PER_SESSION=20
